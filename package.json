{
  "name": "shiplens-workspace",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/cli",
    "apps/docs"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "npm run dev --workspace @shiplens/docs",
    "build": "npm run build --workspace @shiplens/docs",
    "scan": "node packages/cli/src/cli.js",
    "browsers": "node packages/cli/src/cli.js browsers",
    "test": "node --test packages/cli/test/*.test.js",
    "test:ui": "node scripts/check-docs.mjs",
    "test:pack": "node scripts/check-package.mjs",
    "check": "npm test && npm run build",
    "pack:check": "npm pack --workspace shiplens --dry-run",
    "demo": "node scripts/demo.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "demo:interactions": "node scripts/demo-interactions.mjs",
    "demo:review": "node scripts/demo-review.mjs",
    "benchmark:workflow": "node benchmarks/workflow/run.mjs",
    "benchmark:verify": "node benchmarks/workflow/verify.mjs && node benchmarks/checked-review/verify.mjs && node benchmarks/check-audit/verify.mjs && node benchmarks/delivery-proof/verify.mjs",
    "benchmark:checked": "node benchmarks/checked-review/run.mjs",
    "test:plan-docs": "node scripts/verify-docs-plan.mjs",
    "benchmark:audit": "node benchmarks/check-audit/run.mjs",
    "benchmark:delivery": "node benchmarks/delivery-proof/run.mjs"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@types/node": "26.5.0",
    "prettier": "3.9.6",
    "typescript": "7.0.2"
  }
}
