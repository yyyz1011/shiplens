{
  "name": "shiplens",
  "version": "0.6.0",
  "description": "Repeatable browser evidence, AI acceptance reviews and regression cases for your existing coding assistant.",
  "type": "module",
  "bin": {
    "shiplens": "src/cli.js"
  },
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    },
    "./review": {
      "types": "./src/review.d.ts",
      "import": "./src/review.js"
    }
  },
  "files": [
    "src",
    "README.md",
    "LICENSE",
    "examples",
    "AGENT_GUIDE.md"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "license": "MIT",
  "keywords": [
    "website",
    "audit",
    "playwright",
    "cli",
    "qa",
    "ai",
    "smoke-test"
  ],
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "playwright": "1.63.0",
    "zod": "4.5.4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yyyz1011/shiplens.git",
    "directory": "packages/cli"
  },
  "homepage": "https://shiplens.nimokit.com/",
  "bugs": {
    "url": "https://github.com/yyyz1011/shiplens/issues"
  },
  "author": "yeyezhou",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
